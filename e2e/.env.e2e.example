# Copy this file to .env.e2e (same folder) and fill it in. .env.e2e is never committed and is never shared with anyone.
# Leave a person's lines empty to skip them.

# The address of the site to check, with no slash at the end.
BASE_URL=https://your-manchester-site.example.com

# What you type in "Email / Student ID" and "Password" when you sign in as each person.
STUDENT_LOGIN=
STUDENT_PASSWORD=
TEACHER_LOGIN=
TEACHER_PASSWORD=
HOD_LOGIN=
HOD_PASSWORD=
PRINCIPAL_LOGIN=
PRINCIPAL_PASSWORD=
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Optional
# MAX_PAGES_PER_PERSON=40
# ONLY=student,teacher        (check just these people)
# HEADED=1                    (watch it work in a visible window)
