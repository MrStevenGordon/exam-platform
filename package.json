{
  "name": "exam-platform",
  "version": "0.2.5",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "TURBOPACK=1 next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "SMART_ASSESS_URL=http://localhost:3000 electron electron/main.js",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/pg": "^8.20.3",
    "dotenv": "^17.4.2",
    "idb": "^8.0.3",
    "katex": "^0.17.0",
    "motion": "^12.43.0",
    "next": "^16.2.10",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.1",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "ja.smartassess.desktop",
    "productName": "Smart Assess",
    "directories": {
      "app": "electron",
      "output": "electron-dist"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "SmartAssess-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "SmartAssess-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "MrStevenGordon",
      "repo": "exam-platform-releases"
    }
  }
}
